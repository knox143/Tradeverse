# TradeVerse Environment Configuration

# Flask Secret Key for session cookies (safe fallback provided if empty)
FLASK_SECRET_KEY=tradeverse-production-secure-key-change-this

# Twelve Data API key for live US stock and index quotes (optional, fallback catalogue provided)
TWELVEDATA_API_KEY=

# CoinGecko API key for live cryptocurrency quotes (optional)
COINGECKO_API_KEY=

# Custom User Price & Chart API (Optional: plug in your custom API here)
# When configured, TradeVerse queries this endpoint first for prices and charts:
# Example: https://my-custom-api.com/v1/quote
CUSTOM_PRICE_API_URL=
CUSTOM_PRICE_API_KEY=
# Example: https://my-custom-api.com/v1/chart (or defaults to CUSTOM_PRICE_API_URL/chart)
CUSTOM_CHART_API_URL=

# Quote & Chart Cache TTL in seconds (default: 600 = 10 minutes)
PRICE_CACHE_TTL_SECONDS=600

# HTTP Request Timeout in seconds (default: 5)
REQUEST_TIMEOUT_SECONDS=5

# Custom writable runtime data directory (default: workspace locally, /tmp/tradeverse on Vercel)
TRADEVERSE_RUNTIME_DATA_DIR=
